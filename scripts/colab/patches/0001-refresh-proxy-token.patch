+# The runtime proxy token is minted once, when the VM is assigned, and lasts
+# about an hour -- while the assignment itself lives for many hours behind this
+# very daemon. Nothing refreshed the token, so the two clocks diverged: at ~60
+# minutes every kernel request 404s on a perfectly healthy VM, and the CLI then
+# prunes the local record, reporting "Session not found" for a machine that is
+# still running the user's job. The keep-alive daemon is the right owner of the
+# refresh: it already runs on a timer, per session, and knows the endpoint.
+PROXY_TOKEN_REFRESH_MARGIN_SECONDS = 900
+
+
+def proxy_token_expiry(token: str) -> Optional[float]:
+    """`exp` out of the proxy token, which is a plain JWT.
+
+    None when the token cannot be read, which callers should treat as "refresh
+    it" rather than "it is fine".
+    """
+    try:
+        body = token.split(".")[1]
+        body += "=" * (-len(body) % 4)
+        return float(json.loads(base64.urlsafe_b64decode(body))["exp"])
+    except Exception:
+        return None
+
+
+def refresh_proxy_token(s: SessionState) -> bool:
+    """Re-mint the cached proxy token if it is close to expiring.
+
+    True when a fresh token was written to the store. A missing assignment is
+    not an error here -- the keep-alive call is what reports a lost VM.
+    """
+    from colab_cli.common import state
+
+    exp = proxy_token_expiry(s.token)
+    if exp is not None:
+        if exp - time.time() > PROXY_TOKEN_REFRESH_MARGIN_SECONDS:
+            return False
+
+    assignment = next(
+        (a for a in state.client.list_assignments() if a.endpoint == s.endpoint),
+        None,
+    )
+    if assignment is None:
+        return False
+
+    info = assignment.runtime_proxy_info
+    # Only the two token fields, so an exec's concurrently written kernel_id
+    # survives.
+    state.store.update(s.name, token=info.token, url=info.url)
+    state.history.log_event(
+        s.name,
+        "proxy_token_refreshed",
+        {"expires_in_seconds": info.token_expires_in_seconds},
+    )
+    return True
+
+
 def spawn_keep_alive(
     endpoint: str, session_name: str, auth_provider=None, config_path=None
 ):
