+    def update(self, name: str, **fields) -> Optional[SessionState]:
+        """Read-modify-write a subset of one session's fields under the lock.
+
+        `add` replaces the whole record, so a writer that only means to change
+        one field would clobber anything another process wrote in between --
+        e.g. the `kernel_id` an in-flight `exec` had just recorded. Returns the
+        updated state, or None if the session is not in the store.
+        """
+        with self._lock_exclusive() as f:
+            sessions = self._load_raw(f)
+            s = sessions.get(name)
+            if s is None:
+                return None
+            for key, value in fields.items():
+                setattr(s, key, value)
+            self._save_raw(f, sessions)
+            return s
+
+
     def remove(self, name: str):
         with self._lock_exclusive() as f:
             sessions = self._load_raw(f)
